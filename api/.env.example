# Port the API listens on
PORT=3000

# Comma-separated list of origins allowed to call the API.
# Leave unset in development — localhost:5173 (Vite) is allowed by default.
# In production set this to your deployed frontend URL, e.g.:
# CORS_ORIGINS=https://omiddeldar.dev,https://www.omiddeldar.dev
CORS_ORIGINS=
